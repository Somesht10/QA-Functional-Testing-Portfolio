{
  "info": {
    "name": "REST API Automation & Payload Validation Suite",
    "description": "Functional API verification suite asserting dynamic JWT authentication, status codes, and payload schemas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - User Authentication & Token Extraction",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"eve.holt@reqres.in\",\n  \"password\": \"cityslicka\"\n}"
        },
        "url": {
          "raw": "https://reqres.in/api/login",
          "protocol": "https",
          "host": ["reqres", "in"],
          "path": ["api", "login"]
        }
      }
    },
    {
      "name": "02 - Fetch User Profile Data (Bearer Auth)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": {
          "raw": "https://reqres.in/api/users/2",
          "protocol": "https",
          "host": ["reqres", "in"],
          "path": ["api", "users", "2"]
        }
      }
    }
  ]
}